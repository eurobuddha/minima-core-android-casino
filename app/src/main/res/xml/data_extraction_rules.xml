<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup/transfer rules. Cloud backup AND device transfer (Smart Switch) are
   governed separately — both are excluded.

   NOTHING in this app may leave the device. allowBackup="false" already disables this, but the excludes are
   explicit so the intent survives anyone flipping that flag back. What is at stake here:
   casino_secrets — the commit preimages that gate real pots. Two ways round: the plaintext fallback
         file ships them off-device, and a restored Keystore-bound copy cannot be decrypted at all, so every
         in-flight bet's secret becomes unreadable and the pot strands to the counterparty's timeout claim
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>

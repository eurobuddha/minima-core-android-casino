<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:background="@color/panel">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ZERO EDGE CASINO"
                android:textColor="@color/gold"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textSize="15sp"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Provably Fair On-Chain"
                android:textColor="@color/cyan"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/gold"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/liveDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/dot_live" />

                <TextView
                    android:id="@+id/blockNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#0"
                    android:textColor="@color/text"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnCcy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="MINIMA"
            android:textSize="10sp"
            android:textColor="@color/bg"
            android:backgroundTint="@color/gold" />

        <Button
            android:id="@+id/btnSound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="SND"
            android:textSize="10sp"
            android:textColor="@color/bg"
            android:backgroundTint="@color/cyan" />
    </LinearLayout>

    <!-- Activity ticker — latest log line, always visible; tap for full log -->
    <TextView
        android:id="@+id/ticker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="@color/cyan"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:text="Starting up…" />

    <!-- Pairing banner (hidden until needed) -->
    <TextView
        android:id="@+id/pairingBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:padding="12dp"
        android:text="Open Minima Core → Apps and enable Zero Edge Casino, then return here."
        android:textColor="@color/bg"
        android:background="@color/gold"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/timeoutBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:visibility="gone"
        android:focusable="true"
        android:textColor="@color/bg"
        android:background="@color/gold"
        android:textSize="12sp" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panel"
        app:tabIndicatorColor="@color/gold"
        app:tabSelectedTextColor="@color/gold"
        app:tabTextColor="@color/text"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
